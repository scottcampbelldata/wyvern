<Window x:Class="Wyvern.App.SyncKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wyvern: Sync Key"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Ink}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- The colours and the look of boxes and buttons, shared with the other windows. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Look.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        </ResourceDictionary>
    </Window.Resources>
    <!-- The key is a text block, which cannot be selected, so the Copy button, which marks what
         it writes, is the only way the key reaches the clipboard. -->
    <StackPanel Margin="20,18,20,18">
        <!-- Shown by the code-behind only when Windows would not keep this window out of
             pictures of the screen. -->
        <TextBlock x:Name="CaptureWarning" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,12"
                   FontWeight="SemiBold" Foreground="DarkRed"
                   Text="This window could not be kept out of screen captures. Do not share your screen while it is open." />
        <TextBlock FontFamily="Consolas" FontSize="15" Margin="0,0,0,12" Text="{Binding KeyText}"
                   Visibility="{Binding HasKey, Converter={StaticResource VisibleWhenTrue}}" />
        <TextBlock TextWrapping="Wrap" Text="{Binding Message}" />
        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Padding="12,4" MinWidth="90" Content="Copy" Click="OnCopy" IsEnabled="{Binding HasKey}" />
            <Button Padding="12,4" MinWidth="90" Margin="8,0,0,0" Content="Close" IsCancel="True" IsDefault="True" Click="OnClose" />
        </StackPanel>
    </StackPanel>
</Window>
