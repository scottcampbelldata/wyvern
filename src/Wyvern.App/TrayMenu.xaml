<Window x:Class="Wyvern.App.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wyvern"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <FontFamily x:Key="Glyphs">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- The colours, light to begin with; LauncherLook.Apply swaps them when Windows is dark. -->
        <SolidColorBrush x:Key="Bg" Color="#FFFBFBFB" />
        <SolidColorBrush x:Key="Stroke" Color="#FFD0D0D0" />
        <SolidColorBrush x:Key="Line" Color="#FFE5E5E5" />
        <SolidColorBrush x:Key="Ink" Color="#FF242424" />
        <SolidColorBrush x:Key="Dim" Color="#FF8A8A8A" />
        <SolidColorBrush x:Key="Pick" Color="#FFEAEAEB" />

        <!-- One line of the menu: a sign, then the words. Grey under the pointer. -->
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Height="32" Margin="5,0" Padding="9,0,16,0" CornerRadius="6" Background="Transparent">
                            <DockPanel VerticalAlignment="Center">
                                <TextBlock x:Name="Sign"
                                           DockPanel.Dock="Left"
                                           Width="18"
                                           Margin="0,0,10,0"
                                           FontFamily="{StaticResource Glyphs}"
                                           FontSize="15"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Ink}"
                                           Text="{Binding Glyph}" />
                                <TextBlock x:Name="Words"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Ink}"
                                           Text="{Binding Text}" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Pick}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Row" Property="Background" Value="Transparent" />
                                <Setter TargetName="Sign" Property="Foreground" Value="{DynamicResource Dim}" />
                                <Setter TargetName="Words" Property="Foreground" Value="{DynamicResource Dim}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <!-- The shadow sits on its own element so the effect does not blur the text above it. -->
        <Border CornerRadius="10" Background="{DynamicResource Bg}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.25" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="10" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" MinWidth="230">
            <StackPanel x:Name="Rows" Margin="0,5" />
        </Border>
    </Grid>
</Window>
