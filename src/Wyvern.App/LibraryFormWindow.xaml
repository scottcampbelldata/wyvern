<Window x:Class="Wyvern.App.LibraryFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wyvern"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Ink}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <!-- The colours and the look of boxes and buttons, shared with the other windows. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Look.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- A box for text of many lines: the text starts at the top and the box scrolls. -->
            <Style x:Key="Lines" TargetType="TextBox">
                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Edge" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Stroke}" Background="{DynamicResource Bg}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="6,5" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <!-- A form that makes one thing for the library: a snippet (a name, a keyword, the text) or
         a quicklink (a name, the link, a keyword). The code shows the rows of the one it makes. -->
    <StackPanel Margin="22,20,22,18">
        <TextBlock x:Name="Heading" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" Text="Create Snippet" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Name" />
            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,3" MaxLength="100" />

            <!-- A quicklink only. -->
            <TextBlock x:Name="LinkLabel" Grid.Row="1" VerticalAlignment="Center" Text="Link" />
            <TextBox x:Name="LinkBox" Grid.Row="1" Grid.Column="1" Margin="0,3" />
            <TextBlock x:Name="LinkHint" Grid.Row="2" Grid.Column="1" Margin="0,2,0,8" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Dim}"
                       Text="A web address, or the path of a file or a folder. Put {query} in it where what you type in the launcher should go: https://example.com/search?q={query}" />

            <!-- A snippet only. -->
            <TextBlock x:Name="TextLabel" Grid.Row="3" VerticalAlignment="Top" Margin="0,8,0,0" Text="Text" />
            <TextBox x:Name="BodyBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource Lines}" Margin="0,3" Height="190" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
            <TextBlock x:Name="TextHint" Grid.Row="4" Grid.Column="1" Margin="0,2,0,8" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Dim}"
                       Text="{}{date}, {time} and {clipboard} in the text are filled in when the snippet is pasted." />

            <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Keyword" />
            <TextBox x:Name="KeywordBox" Grid.Row="5" Grid.Column="1" Margin="0,3" Width="180" HorizontalAlignment="Left" MaxLength="50" />
            <TextBlock x:Name="KeywordHint" Grid.Row="6" Grid.Column="1" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Dim}"
                       Text="Optional. One word that brings it to the top in the launcher." />
        </Grid>

        <!-- What could not be saved, and the two buttons. -->
        <DockPanel Margin="0,18,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource MainButton}" Padding="14,5" MinWidth="90" Content="Save" Click="OnSave" />
            <Button DockPanel.Dock="Right" Padding="14,5" MinWidth="90" Margin="0,0,8,0" Content="Cancel" IsCancel="True" Click="OnCancel" />
            <TextBlock x:Name="Status" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0" Foreground="{DynamicResource Dim}" />
        </DockPanel>
    </StackPanel>
</Window>
