<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The look the ordinary windows share with the launcher: its colours (light to begin
         with; LauncherLook.Apply swaps them when Windows is dark) and how a box to type in, a
         button, a choice and a tick box are drawn. A window that merges this file gets all of
         it without naming a style. -->
    <SolidColorBrush x:Key="Bg" Color="#FFFBFBFB" />
    <SolidColorBrush x:Key="Stroke" Color="#FFD0D0D0" />
    <SolidColorBrush x:Key="Line" Color="#FFE5E5E5" />
    <SolidColorBrush x:Key="Ink" Color="#FF242424" />
    <SolidColorBrush x:Key="Dim" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="Faint" Color="#FFA9A9A9" />
    <SolidColorBrush x:Key="Pick" Color="#FFEAEAEB" />
    <SolidColorBrush x:Key="Chip" Color="#FFE8E8E9" />
    <SolidColorBrush x:Key="Accent" Color="#FF3B82F6" />

    <Style TargetType="TextBox">
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Edge" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Stroke}" Background="{DynamicResource Bg}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="6,2" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Edge" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Edge" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Stroke}" Background="{DynamicResource Bg}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="6,2" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Edge" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Back" CornerRadius="6" Padding="13,4" Background="{DynamicResource Chip}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource Stroke}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource Stroke}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Back" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The button that does what the window is for. -->
    <Style x:Key="MainButton" TargetType="Button">
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Back" CornerRadius="6" Padding="16,4" Background="{DynamicResource Accent}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Back" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    </Style>
</ResourceDictionary>
