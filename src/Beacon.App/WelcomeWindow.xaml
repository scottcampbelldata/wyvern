<Window x:Class="Beacon.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Beacon"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Ink}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- The colours and the look of boxes and buttons, shared with the other windows. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Look.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Shown once, the first time Beacon runs on a PC whose clipboard history has no hotkey
         yet: the two hotkeys Beacon is used by, each set by pressing it. -->
    <StackPanel Margin="26,24,26,20">
        <TextBlock FontSize="21" FontWeight="SemiBold" Text="Welcome to Beacon" />
        <TextBlock TextWrapping="Wrap" Margin="0,8,0,20" Foreground="{DynamicResource Dim}"
                   Text="Beacon lives in the notification area and opens from anywhere with a hotkey. Set the two you will use most. Click a box and press the keys; both can be changed later under Settings." />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Open Beacon" />
            <TextBox x:Name="HotkeyBox" Grid.Row="0" Grid.Column="1" Width="200" HorizontalAlignment="Left" IsReadOnly="True" PreviewKeyDown="OnHotkeyKeyDown" />
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2,0,14" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Dim}"
                       Text="Opens and closes the launcher: apps, files, commands, snippets and the calculator." />

            <TextBlock Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="Clipboard History" />
            <TextBox x:Name="ClipHotkeyBox" Grid.Row="2" Grid.Column="1" Width="200" HorizontalAlignment="Left" IsReadOnly="True" PreviewKeyDown="OnHotkeyKeyDown" />
            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Dim}"
                       Text="Opens what you copied earlier, to find it and paste it again. Many programs use Ctrl+Shift+V to paste without formatting: press other keys if you use that. Backspace clears the box." />
        </Grid>

        <DockPanel Margin="0,22,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource MainButton}" Padding="14,5" MinWidth="110" Content="Get Started" IsDefault="True" Click="OnSave" />
            <Button DockPanel.Dock="Right" Padding="14,5" MinWidth="90" Margin="0,0,8,0" Content="Not Now" IsCancel="True" Click="OnSkip" />
            <TextBlock x:Name="Status" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0" Foreground="{DynamicResource Dim}" />
        </DockPanel>
    </StackPanel>
</Window>
