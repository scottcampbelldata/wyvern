<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Beacon</AssemblyName>
    <RootNamespace>Beacon.App</RootNamespace>
    <ApplicationIcon>Beacon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The icon is the program file's own (what a shortcut shows) and is packed in once more for
       the tray icon, which reads it from memory. It is drawn by installer\make-icon.ps1. -->
  <ItemGroup>
    <EmbeddedResource Include="Beacon.ico" LogicalName="Beacon.ico" />
  </ItemGroup>

  <!-- Where this build looks for updates and the key they must be signed with. The file is
       the owner's and is not in the repository (installer\new-update-key.ps1 makes it): a
       build without it has no update server and never looks for updates. -->
  <ItemGroup Condition="Exists('..\..\installer\update-channel.json')">
    <EmbeddedResource Include="..\..\installer\update-channel.json" LogicalName="update-channel.json" Link="update-channel.json" />
  </ItemGroup>

  <!-- WinForms is referenced only for the tray icon. Its implicit usings clash with WPF type names. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Beacon.Core\Beacon.Core.csproj" />
  </ItemGroup>

</Project>
