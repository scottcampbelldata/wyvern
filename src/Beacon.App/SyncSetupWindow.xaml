<Window x:Class="Beacon.App.SyncSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beacon: Sync Setup"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Ink}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- The colours and the look of boxes and buttons, shared with the other windows. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Look.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        </ResourceDictionary>
    </Window.Resources>
    <!-- Everything here only shows the view model and hands clicks to it. What is checked, and
         what is written where, is decided in SyncSetupViewModel. -->
    <StackPanel Margin="20,18,20,18">
        <!-- Shown by the code-behind only when Windows would not keep this window out of
             pictures of the screen. -->
        <TextBlock x:Name="CaptureWarning" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,12"
                   FontWeight="SemiBold" Foreground="DarkRed"
                   Text="This window could not be kept out of screen captures. Do not share your screen while it is open." />

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
            Beacon syncs with one server of your own, over SFTP. Everything is encrypted on this
            machine before it is sent: the server never sees a file's name, its content or the sync key.
        </TextBlock>

        <!-- While a check or the saving is under way, and once it is saved, the form takes no
             input, so that what is on the screen is what was tested and what is saved. A panel
             that is not enabled turns off every control inside it: the text boxes, the Browse
             button and the password box here, the key choices and the box for a typed key in
             the group below. -->
        <Grid IsEnabled="{Binding CanEdit}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Server" />
            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Port" />
            <TextBox Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="User" />
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="SSH key file" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding KeyFile, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="3" Grid.Column="2" Margin="6,3,0,3" Content="Browse..." Click="OnBrowse" />

            <!-- Shown once the key file has said that it has a passphrase. A password box cannot
                 be bound, and what is typed is never put back into it. -->
            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Key passphrase"
                       Visibility="{Binding NeedsPassphrase, Converter={StaticResource VisibleWhenTrue}}" />
            <PasswordBox x:Name="PassphraseBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3" Padding="3"
                         PasswordChanged="OnPassphraseChanged"
                         Visibility="{Binding NeedsPassphrase, Converter={StaticResource VisibleWhenTrue}}" />

            <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Folder on the server" />
            <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding RemoteDir, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <GroupBox Header="Sync key" Margin="0,12,0,0" Padding="8">
            <StackPanel IsEnabled="{Binding CanEdit}">
                <RadioButton Margin="0,2" Content="Keep the sync key this machine already has"
                             IsChecked="{Binding KeepKey}"
                             Visibility="{Binding CanKeep, Converter={StaticResource VisibleWhenTrue}}" />
                <RadioButton Margin="0,2" Content="Generate a new sync key (the first machine, and an empty folder on the server)"
                             IsChecked="{Binding GenerateKey}" />
                <RadioButton Margin="0,2" Content="Enter the sync key from my other machine"
                             IsChecked="{Binding EnterKey}" />
                <!-- A key that is typed in has to be read back by eye, so it is in a text box and
                     not in a password box. Nothing leaves the box: it has no menu, it keeps no
                     history of what was typed, and the code-behind calls off its copy, its cut
                     and a drag out of it. Pasting into it works. The box is on only for this
                     choice, and only while the panel it is in is on. -->
                <TextBox x:Name="EnteredKeyBox" FontFamily="Consolas" IsEnabled="{Binding EnterKey}"
                         ContextMenu="{x:Null}" IsUndoEnabled="False"
                         Text="{Binding EnteredKey, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </GroupBox>

        <Button Margin="0,12,0,0" HorizontalAlignment="Left" Content="Test Connection" Click="OnTest" IsEnabled="{Binding CanTest}" />

        <!-- The server's host key, once the test has read it. It is pinned only when the box is ticked. -->
        <StackPanel Margin="0,10,0,0" Visibility="{Binding FingerprintShown, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock Text="The server's host key fingerprint:" />
            <TextBlock FontFamily="Consolas" FontSize="14" Margin="0,4" Text="{Binding Fingerprint}" />
            <TextBlock Foreground="Gray" Text="{Binding FingerprintKind}" />
            <CheckBox Margin="0,8,0,0" Content="I have compared this with the server's own fingerprint, and it is the same"
                      IsChecked="{Binding FingerprintConfirmed}" IsEnabled="{Binding CanEdit}" />
        </StackPanel>

        <!-- A check or the saving can take as long as the connection does, and nothing else on
             the form moves meanwhile. -->
        <TextBlock Margin="0,12,0,0" Text="Working..." Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}" />

        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding Message}" />

        <!-- A new key, shown once after saving. It is a text block, which cannot be selected, so
             the Copy button, which marks what it writes, is the only way it reaches the clipboard. -->
        <DockPanel Margin="0,8,0,0" Visibility="{Binding HasGeneratedKey, Converter={StaticResource VisibleWhenTrue}}">
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Copy" Click="OnCopyKey" />
            <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="14" Text="{Binding GeneratedKey}" />
        </DockPanel>

        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource MainButton}" Content="Save" Click="OnSave" IsEnabled="{Binding CanSave}" />
            <Button Margin="8,0,0,0" Content="Close" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </StackPanel>
</Window>
